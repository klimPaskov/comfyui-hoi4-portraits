{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoi4-portrait-pipeline.local/schemas/portrait_benchmark_report.schema.json",
  "title": "HOI4 Portrait Benchmark Report",
  "type": "object",
  "required": ["schema_version", "report_version", "created_at", "profile", "status", "preflight", "resource_model", "measurements", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_version": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "profile": {"enum": ["hoi4_portraits_local_nvidia_16gb", "hoi4_portraits_full_power_gpu", "hoi4_portraits_agent_local_nvidia_16gb", "hoi4_portraits_agent_full_power_gpu"]},
    "status": {"type": "string", "minLength": 1},
    "status_reason": {"type": "string"},
    "hardware": {"type": "object"},
    "preflight": {
      "type": "object",
      "required": ["status", "gate_statuses", "blockers"],
      "properties": {"status": {"type": "string"}, "recommended_exit_code": {"type": "integer"}, "gate_statuses": {"type": "object"}, "blockers": {"type": "array", "items": {"type": "string"}}}
    },
    "resource_model": {
      "type": "object",
      "required": ["expected_model_bytes", "physical_memory_bytes", "capacity_assessment", "locked_artifacts"],
      "properties": {"expected_model_bytes": {"type": "integer", "minimum": 0}, "physical_memory_bytes": {"type": ["integer", "null"], "minimum": 0}, "expected_model_to_physical_memory_ratio": {"type": ["number", "null"], "minimum": 0}, "capacity_assessment": {"type": "string"}, "locked_artifacts": {"type": "array"}}
    },
    "measurements": {"type": "object"},
    "required_follow_up": {"type": "array", "items": {"type": "string"}},
    "claims": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
