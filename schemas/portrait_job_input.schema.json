{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/portrait_job_input.schema.json",
  "title": "HOI4 Portrait Job Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "execution_profile",
    "source_image_path",
    "source_provenance",
    "subject_identity",
    "prompt",
    "intended_hoi4_role",
    "final_output_stem",
    "approved_background",
    "seed_policy",
    "candidate_count",
    "retry_limit",
    "identity_thresholds_id",
    "style_thresholds_id",
    "final_png_path",
    "final_dds_path"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "execution_profile": {
      "enum": [
        "human_local_mac_16gb",
        "human_full_power_gpu",
        "agent_local_mac_16gb",
        "agent_full_power_gpu",
        "agent_remote_runpod"
      ]
    },
    "source_image_path": {
      "type": "string",
      "minLength": 1
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "attribution",
        "rights_notes"
      ],
      "properties": {
        "source_class": {
          "enum": [
            "user_provided",
            "attributed_public_source",
            "repository_source"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri-reference"
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "archive_or_collection": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_notes": {
          "type": "string",
          "minLength": 1
        },
        "license_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "user_authorization_record": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "subject_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_name",
        "identity_classification",
        "real_person"
      ],
      "properties": {
        "record_name": {
          "type": "string",
          "minLength": 1
        },
        "identity_classification": {
          "enum": [
            "grounded_real_person",
            "approved_fictional_subject"
          ]
        },
        "real_person": {
          "type": "boolean"
        },
        "record_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "subject_selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "bbox_xyxy"
          ],
          "properties": {
            "mode": {
              "const": "bbox"
            },
            "bbox_xyxy": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 4,
              "maxItems": 4
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "face_index"
          ],
          "properties": {
            "mode": {
              "const": "face_index"
            },
            "face_index": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "subject_hint"
          ],
          "properties": {
            "mode": {
              "const": "subject_hint"
            },
            "subject_hint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt": {
      "type": "string",
      "pattern": "^hoi4_portrait,",
      "maxLength": 1200
    },
    "intended_hoi4_role": {
      "enum": [
        "country_leader",
        "commander",
        "operative"
      ]
    },
    "final_output_stem": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_]{1,95}$"
    },
    "approved_background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_id",
        "path",
        "sha256"
      ],
      "properties": {
        "registry_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "seed_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "derived",
            "random_recorded"
          ]
        },
        "seed": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "derivation": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "candidate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "retry_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "identity_thresholds_id": {
      "type": "string",
      "minLength": 1
    },
    "style_thresholds_id": {
      "type": "string",
      "minLength": 1
    },
    "final_png_path": {
      "type": "string",
      "minLength": 1
    },
    "final_dds_path": {
      "type": "string",
      "minLength": 1
    },
    "optional_mod_integration": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "mod_root": {
          "type": "string"
        },
        "country_tag": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9]{3}$"
        },
        "character_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "sprite_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "final_gameplay_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "allowed_autoprompt_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nationality": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "ideology": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "medals_or_insignia": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "organization_or_branch": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "jewelry": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
