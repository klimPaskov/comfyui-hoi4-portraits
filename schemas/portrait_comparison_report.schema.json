{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hoi4-portrait-pipeline.local/schemas/portrait_comparison_report.schema.json",
  "title": "HOI4 Portrait Identity and Style Comparison Report",
  "type": "object",
  "required": ["schema_version", "comparison_id", "created_at", "status", "matrix_id", "selection_policy", "candidate_counts", "metrics", "claims"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "comparison_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "minLength": 1},
    "reason": {"type": "string"},
    "matrix_id": {"type": "string", "minLength": 1},
    "selection_policy": {"type": "object", "required": ["identity_first", "selection_order", "face_swap_permitted"], "properties": {"identity_first": {"const": true}, "selection_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "face_swap_permitted": {"const": false}}},
    "candidate_counts": {"type": "object"},
    "comparison_artifacts": {"type": "array"},
    "metrics": {"type": "object"},
    "preflight": {"type": "object"},
    "claims": {"type": "object"}
  },
  "additionalProperties": true
}
