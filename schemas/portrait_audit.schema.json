{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/portrait_audit.schema.json",
  "title": "HOI4 Portrait Candidate Audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "candidate_id",
    "auditor",
    "thresholds_id",
    "hard_gates",
    "verdict",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "job_id": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "auditor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auditor_id",
        "process_id",
        "independent_from_producer",
        "reviewed_at"
      ],
      "properties": {
        "auditor_id": {
          "type": "string"
        },
        "process_id": {
          "type": "string"
        },
        "independent_from_producer": {
          "const": true
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "thresholds_id": {
      "type": "string"
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "face_embedding",
        "landmarks",
        "facial_proportions",
        "asymmetry",
        "head_direction",
        "expression",
        "hairline",
        "facial_hair",
        "accessories",
        "foreground_integrity",
        "mask_boundary",
        "style",
        "provenance"
      ],
      "properties": {
        "face_embedding": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "landmarks": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "facial_proportions": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "asymmetry": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "head_direction": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "expression": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "hairline": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "facial_hair": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "accessories": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "foreground_integrity": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "mask_boundary": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "style": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        },
        "provenance": {
          "enum": [
            "PASS",
            "FAIL",
            "UNCERTAIN"
          ]
        }
      }
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "UNCERTAIN"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_master",
        "processed_reference",
        "candidate",
        "native_comparison",
        "enlarged_comparison",
        "mask_comparison",
        "manifest"
      ],
      "properties": {
        "source_master": {
          "type": "string"
        },
        "processed_reference": {
          "type": "string"
        },
        "candidate": {
          "type": "string"
        },
        "native_comparison": {
          "type": "string"
        },
        "enlarged_comparison": {
          "type": "string"
        },
        "mask_comparison": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        }
      }
    }
  }
}
