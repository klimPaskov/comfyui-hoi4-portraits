{
  "schema_version": "1.0.0",
  "planned_entrypoint": "./scripts/bootstrap/bootstrap.sh",
  "windows_entrypoint": ".\\scripts\\bootstrap\\bootstrap.ps1",
  "required_arguments": {
    "profile": [
      "local_mac_16gb",
      "full_power_gpu",
      "remote_runpod"
    ],
    "restore_from_lock": true
  },
  "required_actions": [
    "detect_hardware_and_operating_system",
    "verify_free_disk_and_memory",
    "create_or_verify_python_environment",
    "install_pinned_comfyui",
    "enable_current_supported_manager",
    "install_pinned_custom_nodes",
    "restore_models_from_verified_sources",
    "verify_model_and_node_checksums",
    "register_immutable_style_lora_without_rewriting_it",
    "resolve_approved_background_registry",
    "validate_four_workflow_ui_json_files",
    "validate_four_workflow_api_json_files",
    "start_loopback_comfyui",
    "validate_mcp_or_project_adapter",
    "run_profile_smoke_tests",
    "write_capability_report"
  ],
  "forbidden_actions": [
    "interactive_manager_clicks",
    "manual_model_file_movement",
    "unauthenticated_public_comfyui",
    "unverified_mirror_download",
    "secret_logging",
    "weight_commit_to_git",
    "style_lora_overwrite",
    "silent_model_substitution"
  ],
  "terminal_outputs": [
    "dependencies/dependencies.lock.json",
    "dependencies/models.lock.json",
    "dependencies/custom_nodes.lock.json",
    "docs/capabilities/<profile>.json",
    "docs/capabilities/<profile>.md",
    "logs/bootstrap/<run_id>.jsonl"
  ]
}
